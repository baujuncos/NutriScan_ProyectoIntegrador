# Copiá este archivo a .env.local y completá los valores reales (.env.local no se commitea).

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini (chat de registro de comida, NUT-188/190). SOLO server-side:
# nunca les pongas prefijo NEXT_PUBLIC_ ni las uses desde componentes cliente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
