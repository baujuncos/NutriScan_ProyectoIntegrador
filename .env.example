# Copiá este archivo a .env.local y completá los valores reales (.env.local no se commitea).

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini (chat de registro de comida, NUT-188/190). SOLO server-side:
# nunca les pongas prefijo NEXT_PUBLIC_ ni las uses desde componentes cliente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Secret del cron de Vercel (obligatorio en Vercel desde la corrección de DEF-002): protege /api/send-reminders.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Pruebas E2E (docs/SETUP_SECRETS.md): usuario de PRUEBA y URL del despliegue a verificar.
E2E_BASE_URL=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
