# Copiá este archivo a .env.local y completá los valores reales (.env.local no se commitea).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (chat de registro de comida, NUT-188/190). SOLO server-side:
# nunca les pongas prefijo NEXT_PUBLIC_ ni las uses desde componentes cliente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Chat de comidas en /alimentacion (NUT-189): "mock" (default, sin cuota) o "real"
# (llama a /api/chat/meal y gasta cuota de Gemini). Reiniciá `npm run dev` al cambiarla.
NEXT_PUBLIC_CHAT_SERVICE=mock
